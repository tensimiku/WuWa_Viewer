# Copy this file to `.env` at the repository root and set your local paths.
# Environment variables take precedence over appsettings.json / appsettings.Local.json.

# Root directory of your Wuthering Waves installation (contains `Client/Content/Paks`)
WUWA_GAME_DIR=D:\Path\To\Wuthering Waves Game

# Path to AES keys JSON (`mainKey` + `dynamicKeys`), relative to repo root or absolute
WUWA_KEYS_PATH=wuwa-keys/keys.json

# Optional cache directory for extracted GLB / PNG / manifest / anim files
# Default when unset: `cache` under the server output directory
# WUWA_CACHE_DIR=./cache

# Optional backend listen URL & Vite frontend proxy/port overrides
# WUWA_API_URL=http://localhost:5180
# VITE_API_TARGET=http://localhost:5180
# VITE_PORT=5173
