<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <RootNamespace>CUE4Parse</RootNamespace>
    <AssemblyName>CUE4Parse</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>TRACE</DefineConstants>
    <NoWarn>CS8632;CS0618;CS1591</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Berrysoft.XXTea" Version="4.0.9" />
    <PackageReference Include="Blake3" Version="3.0.2" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="FixedMathSharp" Version="4.0.1" />
    <PackageReference Include="Fmod5Sharp" Version="3.1.0" />
    <PackageReference Include="GenericReader" Version="2.3.0" />
    <PackageReference Include="Infrablack.UE4Config" Version="0.7.2.97" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageReference Include="LZMA-SDK" Version="22.1.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="OffiUtils" Version="3.1.0" />
    <PackageReference Include="Oodle.NET" Version="2.2.0" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="SubstreamSharp" Version="1.0.3" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.8" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.10" />
    <PackageReference Include="VGAudio" Version="2.2.1" />
    <PackageReference Include="Zlib-ng.NET" Version="1.2.0" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <PropertyGroup>
    <Cue4ParseRoot Condition="'$(Cue4ParseRoot)' == '' and '$(FModelDir)' != ''">$(FModelDir)CUE4Parse\</Cue4ParseRoot>
    <Cue4ParseRoot Condition="'$(Cue4ParseRoot)' == ''">$(MSBuildThisFileDirectory)..\..\CUE4Parse\</Cue4ParseRoot>
    <CueDir>$(Cue4ParseRoot)CUE4Parse\</CueDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(CueDir)**\*.cs" Exclude="$(CueDir)obj\**;$(CueDir)bin\**;$(CueDir)Compression\OodleHelper.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="OodleSharpShim.cs" />
    <Compile Include="OodleHelperNet9.cs" />
    <EmbeddedResource Include="$(CueDir)Resources\ACE7Key.bin" LogicalName="CUE4Parse.Resources.ACE7Key.bin" />
    <EmbeddedResource Include="$(CueDir)Resources\PUBGNameHashMap.json" LogicalName="CUE4Parse.Resources.PUBGNameHashMap.json" />
    <EmbeddedResource Include="$(CueDir)Resources\BL4SoundTagsMap.json" LogicalName="CUE4Parse.Resources.BL4SoundTagsMap.json" />
    <EmbeddedResource Include="$(CueDir)Resources\ProSpiDecryptor.dll.gz" LogicalName="CUE4Parse.Resources.ProSpiDecryptor.dll.gz" />
    <EmbeddedResource Include="$(CueDir)Resources\ShaderHashedNames.json" LogicalName="CUE4Parse.Resources.ShaderHashedNames.json" />
    <EmbeddedResource Include="$(CueDir)Resources\MogKeyPool.bin" LogicalName="CUE4Parse.Resources.MogKeyPool.bin" />
  </ItemGroup>
</Project>

